APP_NAME=marventa_ai
DEBUG=true
JWT_SECRET=change-me-in-production-use-a-random-string
JWT_EXPIRE_MINUTES=1440
ENABLE_DEMO_USER=false
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-local-development-password
# DEMO_EMAIL=demo@local.dev
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Channel account authorization. Obtain credentials from each official developer platform.
DOUYIN_CHANNEL_CLIENT_KEY=
DOUYIN_CHANNEL_CLIENT_SECRET=
DOUYIN_CHANNEL_REDIRECT_URI=
# Preserve the existing OAuth default. If your app already requests video.create.bind,
# retain it. Append video.list only AFTER app approval, then reauthorize accounts.
# Example after approval: user_info,video.create.bind,video.list
DOUYIN_CHANNEL_SCOPES=user_info
XIAOHONGSHU_CHANNEL_APP_ID=
XIAOHONGSHU_CHANNEL_APP_SECRET=
XIAOHONGSHU_CHANNEL_CLIENT_NAME=Marventa AI
FRONTEND_BASE_URL=http://127.0.0.1:3000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=
# Opt in only after reviewing existing scheduled plans and connecting real accounts.
PUBLISHING_SCHEDULER_ENABLED=false
PUBLISHING_POLL_SECONDS=10

# Database and uploads
# Leave DB_PATH unset to use backend/data/market_insight.db.
# DB_PATH=backend/data/market_insight.db
# Optional production database. Leave empty to use SQLite.
# DATABASE_URL=postgresql://marventa:password@127.0.0.1:5432/marventa
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10

# Media storage: local (default) or s3 (AWS S3, Cloudflare R2, MinIO).
MEDIA_STORAGE_BACKEND=local
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=marventa
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_ADDRESSING_STYLE=path
# MEDIA_S3_PUBLIC_BASE_URL=
# MEDIA_S3_PRESIGNED_TTL_SECONDS=900

# Preferred AI provider for market insight and content generation.
# OpenAI-compatible providers can be used by setting CASE_AI_BASE_URL and CASE_AI_MODEL.
CASE_AI_API_KEY=
CASE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CASE_AI_MODEL=qwen3.8-flash

# Optional bounded public-market research for market insight only.
# Requires a CASE_AI_* model supporting OpenAI-compatible function tool calls.
# Disabled by default. No alternative search provider is guessed when unavailable.
INSIGHT_RESEARCH_ENABLED=false
INSIGHT_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Required for case library AI analysis. Use a vision-capable model for images.
# Any compatible provider can be selected via the base URL and model.
CASE_ANALYSIS_AI_API_KEY=
CASE_ANALYSIS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CASE_ANALYSIS_AI_MODEL=qwen3.8-flash

# Optional card modification override. Leave blank to reuse CASE_AI_*.
MODIFY_CARD_AI_API_KEY=
MODIFY_CARD_AI_BASE_URL=
MODIFY_CARD_AI_MODEL=
