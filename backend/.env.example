APP_NAME=marventa_ai
DEBUG=true
JWT_SECRET=change-me-in-production-use-a-random-string
JWT_EXPIRE_MINUTES=1440
ENABLE_DEMO_USER=false
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-local-development-password
# DEMO_EMAIL=demo@local.dev
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Channel account authorization. Obtain credentials from each official developer platform.
DOUYIN_CHANNEL_CLIENT_KEY=
DOUYIN_CHANNEL_CLIENT_SECRET=
DOUYIN_CHANNEL_REDIRECT_URI=
# Preserve the existing OAuth default. If your app already requests video.create.bind,
# retain it. Append video.list/item.comment only AFTER app approval, then
# reauthorize accounts.
# Example after approval: user_info,video.create.bind,video.list,item.comment
DOUYIN_CHANNEL_SCOPES=user_info
XIAOHONGSHU_CHANNEL_APP_ID=
XIAOHONGSHU_CHANNEL_APP_SECRET=
XIAOHONGSHU_CHANNEL_CLIENT_NAME=Marventa AI
FRONTEND_BASE_URL=http://127.0.0.1:3000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=
# Opt in only after reviewing existing scheduled plans and connecting real accounts.
PUBLISHING_SCHEDULER_ENABLED=false
PUBLISHING_POLL_SECONDS=10
# Daily official comment reads are separately opt-in. Runs at the next local
# midnight and processes the previous local calendar date.
LEAD_TRACKING_SYNC_ENABLED=false
LEAD_TRACKING_TIMEZONE=Asia/Shanghai
# Official Douyin item/comment/list permission. Keep configurable in case the
# approved application schema uses a provider-specific replacement.
LEAD_TRACKING_REQUIRED_SCOPE=item.comment
# Analysis runs automatically after a successful daily comment snapshot.
# "rules" keeps all comment text local. "ai" sends bounded comment batches to
# the effective Lead Tracking OpenAI-compatible provider configured below.
LEAD_TRACKING_ANALYSIS_MODE=rules
LEAD_TRACKING_AI_BATCH_SIZE=10
LEAD_TRACKING_AI_TIMEOUT_SECONDS=90

# Database and uploads
# Leave DB_PATH unset to use backend/data/market_insight.db.
# DB_PATH=backend/data/market_insight.db
# Optional production database. Leave empty to use SQLite.
# DATABASE_URL=postgresql://marventa:password@127.0.0.1:5432/marventa
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10

# Media storage: local (default) or s3 (AWS S3, Cloudflare R2, MinIO).
MEDIA_STORAGE_BACKEND=local
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=marventa
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_ADDRESSING_STYLE=path
# MEDIA_S3_PUBLIC_BASE_URL=
# MEDIA_S3_PRESIGNED_TTL_SECONDS=900

# Unified OpenAI-compatible provider. Every AI feature uses this interface
# unless its explicit override switch is enabled.
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.8-flash

# Optional product-area alternatives. When a switch is true, all three matching
# API_KEY / BASE_URL / MODEL values are required; there is no silent fallback.
MARKET_INSIGHT_AI_OVERRIDE_ENABLED=false
MARKET_INSIGHT_AI_API_KEY=
MARKET_INSIGHT_AI_BASE_URL=
MARKET_INSIGHT_AI_MODEL=

CASE_LIBRARY_AI_OVERRIDE_ENABLED=false
CASE_LIBRARY_AI_API_KEY=
CASE_LIBRARY_AI_BASE_URL=
CASE_LIBRARY_AI_MODEL=

CONTENT_STUDIO_AI_OVERRIDE_ENABLED=false
CONTENT_STUDIO_AI_API_KEY=
CONTENT_STUDIO_AI_BASE_URL=
CONTENT_STUDIO_AI_MODEL=

# Optional image-generation tool used by the Content Studio Agent.
CONTENT_STUDIO_IMAGE_GENERATION_ENABLED=false
CONTENT_STUDIO_IMAGE_API_KEY=
CONTENT_STUDIO_IMAGE_BASE_URL=
CONTENT_STUDIO_IMAGE_MODEL=
CONTENT_STUDIO_IMAGE_SIZE=1024x1024
CONTENT_STUDIO_IMAGE_MAX_BYTES=10485760
# Reserved for native ByteDance adapters; filling these does not enable generation.
# Seedream generates images; Seedance generates videos. Use your available model IDs.
CONTENT_STUDIO_SEEDREAM_API_KEY=
CONTENT_STUDIO_SEEDREAM_BASE_URL=
CONTENT_STUDIO_SEEDREAM_MODEL=
CONTENT_STUDIO_SEEDANCE_API_KEY=
CONTENT_STUDIO_SEEDANCE_BASE_URL=
CONTENT_STUDIO_SEEDANCE_MODEL=

CONTENT_STUDIO_JOB_WORKERS=2
CONTENT_STUDIO_JOB_TIMEOUT_SECONDS=900
CONTENT_STUDIO_JOB_MAX_ATTEMPTS=2
# Send current-turn project image references as OpenAI-compatible image_url
# content. JPEG, PNG, and WebP only; videos remain metadata-only.
CONTENT_STUDIO_MULTIMODAL_ENABLED=false
CONTENT_STUDIO_MULTIMODAL_MAX_IMAGES=5
CONTENT_STUDIO_MULTIMODAL_MAX_IMAGE_BYTES=5242880
CONTENT_STUDIO_MULTIMODAL_MAX_TOTAL_BYTES=15728640
# At most one video is converted to temporary chronological JPEG keyframes.
# FFmpeg and ffprobe must be installed on the backend host.
CONTENT_STUDIO_MULTIMODAL_MAX_VIDEOS=1
CONTENT_STUDIO_MULTIMODAL_MAX_VIDEO_BYTES=104857600
CONTENT_STUDIO_MULTIMODAL_MAX_VIDEO_SECONDS=300
CONTENT_STUDIO_MULTIMODAL_VIDEO_FRAMES=4
CONTENT_STUDIO_MULTIMODAL_FRAME_MAX_BYTES=2097152
CONTENT_STUDIO_MULTIMODAL_FRAME_WIDTH=768
CONTENT_STUDIO_FFMPEG_PATH=ffmpeg
CONTENT_STUDIO_FFPROBE_PATH=ffprobe
CONTENT_STUDIO_FFMPEG_TIMEOUT_SECONDS=30
CONTENT_STUDIO_TRANSCRIPTION_ENABLED=false
CONTENT_STUDIO_TRANSCRIPTION_MODEL=
CONTENT_STUDIO_TRANSCRIPTION_MAX_AUDIO_BYTES=26214400

LEAD_TRACKING_AI_OVERRIDE_ENABLED=false
LEAD_TRACKING_AI_API_KEY=
LEAD_TRACKING_AI_BASE_URL=
LEAD_TRACKING_AI_MODEL=

# Optional bounded public-market research for market insight only.
# Requires the effective Market Insight model to support function tool calls.
# Disabled by default. No alternative search provider is guessed when unavailable.
INSIGHT_RESEARCH_ENABLED=false
INSIGHT_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
